# Porta do backend (NestJS). Este projeto usa dois arquivos de ambiente
# (carregados por ConfigModule.forRoot em src/app.module.ts, ambos
# ignorados pelo git):
#   - .env      → modo de desenvolvimento interativo. Porta fixa: 3105.
#   - .env.test → modo de revisão e teste (npm run test:e2e, agentes de IA
#                 executando/revisando a aplicação). Porta fixa: 3115.
#                 Selecionado automaticamente quando NODE_ENV=test.
# O frontend correspondente (app/) segue a mesma convenção nas portas
# 9105 (dev) e 9115 (revisão/teste) — ver app/.env.example.
#
# Copie este arquivo para .env com APP_PORT=3105, e para .env.test com
# APP_PORT=3115.
APP_PORT=3105
APP_ENV=development

# Reverse proxy
# Use 1 quando a API estiver atrás de um único proxy reverso, como Caddy.
# Pré-requisito do rate limit por IP: sem TRUST_PROXY=1, todo cliente atrás do
# proxy compartilha o mesmo IP (o do proxy) e cairia no mesmo balde.
TRUST_PROXY=0

# Rate limit da autenticação (@nestjs/throttler) — limites ajustáveis, com
# defaults sensatos. Aplicado apenas às rotas públicas de auth.
THROTTLE_RESET_EMAIL_LIMIT=3
THROTTLE_RESET_EMAIL_TTL_MIN=15
THROTTLE_RESET_IP_LIMIT=10
THROTTLE_SIGNIN_LIMIT=10

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_forte_em_producao
JWT_QRCODE_SECRET=troque_por_uma_chave_qrcode_forte_em_producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque_por_uma_chave_refresh_forte_em_producao
JWT_REFRESH_EXPIRES_IN=1d
JWT_PORTARIA_CUTOFF_1=06:00
JWT_PORTARIA_CUTOFF_2=18:00

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=

# Firebase Cloud Messaging (push notifications)
# Obtenha as credenciais em Firebase Console > Service Accounts > Generate new private key.
# A chave privada deve manter os \n escapados (string única).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=